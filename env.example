# ── KabutiFlare Bot ──────────────────────────────────────────
BOT_TOKEN=
ADMIN_ID=
WEBAPP_URL=
PRIVATE_MODE=false
ALLOWED_USERS=

# ── Node identity & HA leader election ───────────────────────
NODE_ID=
CF_TG_HEARTBEAT_INTERVAL=30
CF_TG_LEADER_TTL=90

# ── Admin-only Auto-Failover ─────────────────────────────────
CF_API_TOKEN=
CF_ZONE_ID=
CONFIG_RECORD_NAME=_failover.example.com
TELEGRAM_CHAT_ID=
NODE_PRIORITY=
TARGET_RECORDS=

# ── Health check ─────────────────────────────────────────────
CHECK_METHOD=tcp
CHECK_PORT=443
CHECK_SCHEME=https
HEALTH_PATH=/
CHECK_TIMEOUT=5
CHECK_INTERVAL=30
DNS_TTL=60
DEFAULT_PROXIED=false

# Set to false on an IPv6-only VPS
FORCE_IPV4=true
